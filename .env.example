# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Supabase (real sign-in) ---
# Leave these empty to run the app in demo mode (mock data, any 6-digit code works).
# Copy them from Supabase: Project Settings > API. Put real values in .env.local (never commit it).
# Only the public "anon" key goes here. NEVER put the service_role key in any VITE_ variable.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
# Country code used when someone types a local number like 0599123456 (970 = Palestine).
VITE_DEFAULT_COUNTRY_CODE="970"

# ANTHROPIC_API_KEY: Claude key for AI grading. Server-side only, never in the browser.
# Put the real value in .env.local (not committed).
ANTHROPIC_API_KEY=""

# Optional grading settings (defaults shown). The cheap model grades first;
# the stronger one is used only when the first is unsure.
# GRADING_MODEL=claude-haiku-5-5
# GRADING_ESCALATION_MODEL=claude-opus-5-5
# GRADING_ESCALATE_AT=low

# Optional models for the teacher's AI tools (question generation, study plans…).
# AI_TOOLS_MODEL=claude-opus-5-5
# AI_TOOLS_CHECK_MODEL=claude-sonnet-5-5
